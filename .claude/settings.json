{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:*)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(npm run db:status)",
      "Bash(npm run db:validate)",
      "Bash(npm run db:generate)",
      "Bash(npm run changeset:status)",
      "Bash(npx vitest run:*)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma generate)",
      "Bash(npx changeset status:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(npx vercel ls:*)",
      "Bash(npx vercel logs:*)"
    ],
    "ask": [
      "Bash(npm run db:migrate:*)",
      "Bash(npm run db:deploy)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx vercel deploy:*)",
      "Bash(npx vercel env:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.vercel/.env*)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
